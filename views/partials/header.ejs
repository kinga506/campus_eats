<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <!-- Campus Eats stylesheet -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Order lookup JavaScript -->
  <script src="/js/orderLookup.js" defer></script>
</head>

<body>

<header class="site-header">

  <a href="/" class="brand">
    <span class="brand-icon">🍽️</span>
    <span>Campus Eats</span>
  </a>

  <nav>
    <a href="/">Home</a>
    <a href="/about">About</a>

    <% if (user) { %>

      <% if (user.role === 'admin') { %>
        <a href="/admin/dashboard">My Dashboard</a>
      <% } %>

      <% if (user.role === 'superadmin') { %>
        <a href="/superadmin/dashboard">Super Admin</a>
      <% } %>

      <span>Hi, <%= user.name %></span>

      <form action="/logout" method="POST" style="display: inline;">
        <button type="submit" class="link-btn">Log Out</button>
      </form>

    <% } else { %>

      <a href="/login">Log In</a>
      <a href="/signup">Sign Up</a>

    <% } %>
  </nav>

</header>